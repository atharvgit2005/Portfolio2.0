# Dependencies
# A leading slash ensures it only matches the root node_modules
/node_modules

# Production build folder
/build
/dist

# Log files
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment variables
# Ignore all .env files...
.env.*
# ...but DO NOT ignore the example file
!.env.example

# Misc macOS & Editor files
.DS_Store
.vscode/